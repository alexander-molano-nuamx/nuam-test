## Variables de entorno
# MUI X License Key (Pro/Premium)
# Para Next.js debe tener el prefijo NEXT_PUBLIC_
NEXT_PUBLIC_MUI_LICENSE=MUI_LICENSE_KEY
# Para Vite debe tener el prefijo VITE_
VITE_MUI_LICENSE=MUI_LICENSE_KEY
# También puedes usar sin prefijo
MUI_LICENSE_KEY=MUI_LICENSE_KEY
# ----------------------------------------------
